{
  "name": "rage-optimiser-backend",
  "version": "1.0.0",
  "description": "Backend API and Discord Bot server for Rage Optimiser dashboard.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "deploy:commands": "tsx src/scripts/deploy-all-commands.ts",
    "upm:snapshot": "tsx src/scripts/upm-snapshot.ts",
    "upm:restore": "tsx src/scripts/upm-restore.ts",
    "upm:rollback": "tsx src/scripts/upm-rollback.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "discord.js": "14.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "kazagumo": "^3.3.1",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1",
    "otplib": "^13.4.1",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.4",
    "shoukaku": "^4.1.0",
    "spotify-uri": "^4.1.0",
    "spotify-url-info": "^3.3.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.16.0",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.6",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.5.10",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
