# ==============================================================================
# 🚀 RAGE OPTIMISER ENTERPRISE — UNIFIED ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=production

# ------------------------------------------------------------------------------
# 🤖 Discord Configuration (Core Bot)
# ------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
GUILD_ID=your_default_guild_id_here
OWNER_ID=your_discord_user_id_here

# ------------------------------------------------------------------------------
# 🎵 Discord Configuration (Music Bot)
# ------------------------------------------------------------------------------
MUSIC_CLIENT_ID=your_music_client_id_here
MUSIC_BOT_PERMISSIONS=36700160

# ------------------------------------------------------------------------------
# 🌐 Network & Port Settings
# ------------------------------------------------------------------------------
PORT=5000
WS_PORT=5001

# ------------------------------------------------------------------------------
# 🔑 Authentication & Cryptography Secrets
# ------------------------------------------------------------------------------
# JWT Secret for dashboard session tokens. MUST be at least 32 characters long.
JWT_SECRET=use_a_strong_random_secret_key_here

# Fallback password if TOTP/OAuth fails (e.g. initial setup)
DASHBOARD_PASSWORD=set_a_fallback_owner_dashboard_password_here

# Token Encryption Key (AES-256-GCM) — Generate 64 hex characters.
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=generate_64_hex_chars_here

# Shared Secret between Core Bot and Music Bot for internal API communication.
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=generate_a_random_secret_here

# ------------------------------------------------------------------------------
# 🔗 Dashboards and Redirect URLs
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4680
DASHBOARD_URL=http://localhost:4680
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback

# ------------------------------------------------------------------------------
# 🗄️ Database Configuration
# ------------------------------------------------------------------------------
# Path to the SQLite database file. Defaults to database.sqlite in the project root.
# Set an absolute path if needed for your hosting environment.
# Examples:
#   DB_PATH=database.sqlite            (project root — default)
#   DB_PATH=/data/rage-optimiser.db   (absolute Linux path)
# DB_PATH=

# ------------------------------------------------------------------------------
# 📝 Logging Levels
# ------------------------------------------------------------------------------
# Options: debug, info, warn, error
LOG_LEVEL=info
